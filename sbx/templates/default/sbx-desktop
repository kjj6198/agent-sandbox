#!/bin/bash
# Starts the sandbox's desktop: an X server on :0 that serves VNC on 127.0.0.1:5900, with
# openbox as the window manager. Template builds run this before the snapshot, so every
# sandbox starts with it running; `sbx view` shows it. VNC needs no password because only
# the guest agent can reach loopback.
set -eu
export DISPLAY=:0
[ -S /tmp/.X11-unix/X0 ] && exit 0
setsid Xvnc :0 -geometry "${SBX_SCREEN:-1280x800}" -depth 24 -rfbport 5900 -localhost \
  -SecurityTypes None -AlwaysShared -desktop sbx >/tmp/xvnc.log 2>&1 </dev/null &
for _ in $(seq 50); do
  [ -S /tmp/.X11-unix/X0 ] && break
  sleep 0.1
done
if [ ! -S /tmp/.X11-unix/X0 ]; then
  echo "Xvnc did not start:" >&2
  tail -20 /tmp/xvnc.log >&2
  exit 1
fi
setsid openbox >/tmp/openbox.log 2>&1 </dev/null &
xsetroot -bitmap /usr/local/share/sbx/wallpaper.xbm -fg '#3d444d' -bg '#1f2328'
echo "desktop on :0, VNC on 127.0.0.1:5900"
