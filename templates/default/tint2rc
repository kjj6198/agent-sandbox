# Dock at the bottom center of the desktop, as launchers only: Chromium, Files,
# Terminal. tint2 also draws a taskbar, but with panel_items = L there is none;
# openbox shows running windows in its own alt-tab and middle-click menu.

rounded = 12
border_width = 1
background_color = #16181a 72
border_color = #ffffff 16

panel_items = L
panel_size = 184 54
panel_position = bottom center horizontal
panel_layer = top
panel_padding = 10 5 10
panel_background_id = 1
wm_menu = 0
panel_dock = 0
strut_policy = follow_size

launcher_padding = 5 4 5
launcher_background_id = 0
launcher_icon_size = 38
launcher_icon_theme_override = 0
launcher_item_app = /usr/local/share/sbx/launchers/chromium.desktop
launcher_item_app = /usr/local/share/sbx/launchers/files.desktop
launcher_item_app = /usr/local/share/sbx/launchers/terminal.desktop
launcher_tooltip = 1
