#!/bin/bash
# Usage: net-setup [N...]
# Idempotent: taps sbxtap0..31 (VMs), netns sbxns0..31 (raw runsc/runc), docker network sbxnet.
# With slot numbers, only (re)configures those slots' tap and netns.
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
SLOTS=${SBX_SLOTS:-32}
OWNER=${SBX_TAP_OWNER:-kalan}
UPLINK=$(ip -o route get 1.1.1.1 | sed -n 's/.* dev \([^ ]*\).*/\1/p')

setup_slot() {
  local n=$1 tap=sbxtap$1 ns=sbxns$1 veth=sbxv$1
  ip link show "$tap" >/dev/null 2>&1 || ip tuntap add dev "$tap" mode tap user "$OWNER" vnet_hdr
  ip addr replace "172.16.$n.1/24" dev "$tap"
  ip link set "$tap" up

  [ -e "/run/netns/$ns" ] || ip netns add "$ns"
  if ! ip link show "$veth" >/dev/null 2>&1; then
    ip netns exec "$ns" ip link del eth0 2>/dev/null || true
    ip link add "$veth" type veth peer name eth0 netns "$ns"
  fi
  ip addr replace "172.18.$n.1/24" dev "$veth"
  ip link set "$veth" up
  ip -n "$ns" addr replace "172.18.$n.2/24" dev eth0
  ip -n "$ns" link set lo up
  ip -n "$ns" link set eth0 up
  ip -n "$ns" route replace default via "172.18.$n.1"
}

if [ $# -gt 0 ]; then
  for n in "$@"; do setup_slot "$n"; done
  exit 0
fi

sysctl -qw net.ipv4.ip_forward=1

ipt() { iptables -C "$@" 2>/dev/null || iptables -I "$@"; }
ipt_nat() { iptables -t nat -C "$@" 2>/dev/null || iptables -t nat -A "$@"; }
for net in 172.16.0.0/16 172.18.0.0/16; do
  ipt_nat POSTROUTING -s "$net" -o "$UPLINK" -j MASQUERADE
done
# Docker sets the FORWARD policy to DROP; let sandbox traffic through ahead of its chains.
for ifc in sbxtap+ sbxv+; do
  ipt FORWARD -i "$ifc" -j ACCEPT
  ipt FORWARD -o "$ifc" -j ACCEPT
done

for n in $(seq 0 $((SLOTS - 1))); do setup_slot "$n"; done

# Explicit subnet: Docker's default pool would hand out 172.18.0.0/16 and collide with the netns range.
docker network inspect sbxnet >/dev/null 2>&1 ||
  docker network create --subnet 172.30.0.0/16 --gateway 172.30.0.1 sbxnet >/dev/null
echo "net-setup: $SLOTS slots ready (uplink $UPLINK)"
