#!/bin/bash
# Usage: fc-start [--api] N [vcpus=2] [mem_mib=1024]
#   default: --no-api --config-file (fastest cold boot)
#   --api:   also serve the API on /run/sbx/fc-N/api.sock (needed for fc-snapshot)
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
api=0
[ "${1:-}" = --api ] && { api=1; shift; }
n=$1 vcpus=${2:-2} mem=${3:-1024}
dir=/run/sbx/fc-$n

"$(dirname "$0")/fc-stop" "$n"
mkdir -p "$dir"

mac=$(printf '06:00:ac:10:%02x:02' "$n")
# pci=off: Firecracker has no PCI bus by default, skipping the probe saves boot time.
boot_args="console=ttyS0 reboot=k panic=1 pci=off quiet random.trust_cpu=on \
ip=172.16.$n.2::172.16.$n.1:255.255.255.0::eth0:off \
init=/sbin/sbx-init ro root=/dev/vda sbx.host=172.16.$n.1 sbx.slot=$n"

jq -n --arg args "$boot_args" --arg tap "sbxtap$n" --arg mac "$mac" \
  --argjson vcpus "$vcpus" --argjson mem "$mem" '{
  "boot-source": {kernel_image_path: "/opt/sbx/kernel/vmlinux", boot_args: $args},
  drives: [{drive_id: "rootfs", path_on_host: "/opt/sbx/images/rootfs.ext4",
            is_root_device: true, is_read_only: true}],
  "network-interfaces": [{iface_id: "eth0", host_dev_name: $tap, guest_mac: $mac}],
  "machine-config": {vcpu_count: $vcpus, mem_size_mib: $mem},
  entropy: {}
}' >"$dir/config.json"

if [ "$api" = 1 ]; then
  mode=(--api-sock "$dir/api.sock")
else
  mode=(--no-api)
fi
setsid firecracker --id "sbx-fc-$n" "${mode[@]}" --config-file "$dir/config.json" \
  </dev/null >"$dir/console.log" 2>&1 &
echo $! >"$dir/pid"
echo "fc-start: slot $n pid $! guest 172.16.$n.2 console $dir/console.log"
