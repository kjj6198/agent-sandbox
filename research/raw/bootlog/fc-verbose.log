prev=0
for line in sys.stdin:
    m=re.match(r"\[\s*(\d+\.\d+)\](.*)",line)
    if not m: continue
    t=float(m.group(1)); gap=t-prev; prev=t
    if gap>0.004: print(f"{t*1000:8.1f}ms (+{gap*1000:6.1f}) {m.group(2)[:110]}")
'
echo "--- last lines"; grep -E "^\[ *[0-9]" $d/fc-console.log | tail -3 | cut -c1-120; grep -c . $d/fc-console.log
grep -E "SBX_INIT" $d/fc-console.log | head -2
